autoload -Uz compinit
compinit
# End of lines added by compinstall

_zconfig="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

# Load environment-local prehooks
[[ -r $_zconfig/pre.zsh ]] && source $_zconfig/pre.zsh

export PATH="/opt/homebrew/bin:$PATH"

_zsh_git_prompt_rc="${ZSH_GIT_PROMPT_RC:-/opt/homebrew/opt/zsh-git-prompt/zshrc.sh}"
[[ -r $_zsh_git_prompt_rc ]] && source $_zsh_git_prompt_rc
unset _zsh_git_prompt_rc

export PROMPT='
[%D{%Y-%m-%d %H:%M:%S%z}][%/]
%n@%M$(git_super_status)> '
export REPORTTIME=60

source <(fzf --zsh)

export EDITOR=vim
autoload -U edit-command-line
zle -N edit-command-line
bindkey -e
bindkey '^x^e' edit-command-line  # Ctrl+X Ctrl+Eにバインド

export PATH="/Users/osak/.local/bin:$PATH"
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

alias vi=vim
alias ls='ls --color -F'

# Load environment-local posthooks
[[ -r $_zconfig/post.zsh ]] && source $_zconfig/post.zsh

unset _zlocal
